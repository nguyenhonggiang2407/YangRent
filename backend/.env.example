# Copy to backend/.env. Generate two separate random values of at least 32 characters.
# Empty signing keys deliberately prevent startup; no shared default credentials.
SECRET_KEY=
JWT_SECRET=
JWT_EXPIRE_MINUTES=10080

# Local development only. Production: supply a persistent PostgreSQL URL privately.
DATABASE_URL=sqlite:///./yangrent.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional uploads. Service-role key stays on the backend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Current storage code uses room-images regardless of STORAGE_BUCKET.
STORAGE_BUCKET=room-images

# Current recommendations/assistant use rule-based/demo logic.
OPENAI_API_KEY=
